# Copy this file to hub/.env and fill it in.

# The one password every team types to sign in (required).
TEAM_PASSWORD=change-me

# Port the hub listens on.
PORT=3000

# Interface to bind. Use 127.0.0.1 when nginx runs on the same machine.
HOST=127.0.0.1

# Sub-path the app is served under behind nginx, e.g. /escape  (leave empty for the root).
BASE_PATH=

# Long random string that signs login cookies. If empty, a new one is made on every
# start and teams have to sign in again after a restart (their results are kept).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to true when the site is served over HTTPS (it is, behind nginx).
COOKIE_SECURE=true

# Where results are saved, relative to the hub folder.
DATA_FILE=data/results.json
